async function updateLeaderboard() {
    try {
        const response = await fetch('https://URL_DATABASE_ANDA.firebaseio.com/donatur.json');
        const data = await response.json();
        const tableBody = document.getElementById('tableBody');
        tableBody.innerHTML = "";

        // Mengubah objek menjadi array dan mengurutkan berdasarkan jumlah
        const list = Object.entries(data).sort((a, b) => b[1].jumlah - a[1].jumlah);

        list.forEach((item, index) => {
            const row = `<tr>
                <td>${index + 1}</td>
                <td>${item[1].nama}</td>
                <td>Rp ${item[1].jumlah.toLocaleString()}</td>
            </tr>`;
            tableBody.innerHTML += row;
        });
    } catch (error) {
        console.error("Gagal memuat data:", error);
    }
}
updateLeaderboard();
