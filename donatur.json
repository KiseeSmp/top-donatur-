// Masukkan Bin ID Anda di bawah ini
const BIN_ID = "668cxxxxxxxxxxxxxxx"; 
const DB_URL = `https://api.jsonbin.io/v3/b/${BIN_ID}/latest`;

async function fetchData() {
    try {
        const res = await fetch(DB_URL);
        const result = await res.json();
        const data = result.record.donatur;
        
        const tableBody = document.getElementById('tableBody');
        tableBody.innerHTML = "";
        
        // Urutkan dari yang terbesar
        data.sort((a, b) => b.jumlah - a.jumlah).forEach(item => {
            tableBody.innerHTML += `<tr><td>${item.nama}</td><td>Rp ${item.jumlah.toLocaleString()}</td></tr>`;
        });
    } catch (e) {
        console.error("Gagal memuat:", e);
    }
}
fetchData();

